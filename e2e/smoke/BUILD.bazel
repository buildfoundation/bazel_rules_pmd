load("@rules_pmd//pmd:config.bzl", "pmd_config")
load("@rules_pmd//pmd:defs.bzl", "pmd", "pmd_test")

pmd_config(
    name = "smoke_config",
    rulesets = ["pmd_ruleset.xml"],
)

# Uses the repository default set by --@rules_pmd//pmd:config in .bazelrc.
pmd(
    name = "smoke_build",
    srcs = ["Smoke.java"],
)

pmd_test(
    name = "smoke_test",
    srcs = ["Smoke.java"],
    config = ":smoke_config",
)
